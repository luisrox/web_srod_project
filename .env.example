# Variables de entorno del laboratorio Srod Almenara.
# Copiar a .env.local. No commitear secretos.

# --- Formulario de contacto (paso 15) ---
# Sin estas claves, en desarrollo POST /api/contacto responde 503 y el form no envía.
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. Laboratorio <lab@srodalmenara.com>
RESEND_FROM=
# CC opcional si no está en CMS (formCcEmail). Dejar vacío si no aplica.
FORM_CC_EMAIL=

TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Sanity (Studio + adapter público, paso 17) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Token Viewer (solo lectura) para las páginas públicas.
SANITY_API_READ_TOKEN=
# Token Editor/Admin para `npm run seed:sanity`. No commitear.
SANITY_API_WRITE_TOKEN=
# Secreto del webhook ISR → POST /api/revalidate
SANITY_REVALIDATE_SECRET=
# Si Sanity cae: en desarrollo el fallback a fixtures está ON.
# En producción, off salvo que pongas true (mejor error de página que copy viejo).
ENABLE_FIXTURE_FALLBACK=

# --- Sitio canónico (SEO, OG, sitemap) ---
# Producción: https://www.srodalmenara.com
# Preview de Vercel: si falta, se usa VERCEL_URL.
NEXT_PUBLIC_SITE_URL=

# --- Instagram Home (paso 19): widget Behold u equivalente, no Graph API ---
# URL pública del JSON del feed (https://feeds.behold.so/…).
# En `next dev`, vacío muestra un preview con stills del lab (no es el muro real).
# En producción, vacío = plan B (solo enlace). `preview` fuerza los stills.
# No pongas tokens de Meta aquí. No commitear .env.local.
BEHOLD_FEED_URL=

# --- Analítica (Plausible, sin cookies de marketing) ---
# Dominio que registras en Plausible, p. ej. srodalmenara.com
# Vacío = no se inyecta el script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
